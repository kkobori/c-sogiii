; ネイティブ(本家ランタイム)用の互換モジュール。ビルド時に main.hsp から自動で読み込まれる。
; 本家の mmload は、ファイルが無いとエラーで止まるため、存在を確認してから読み込む。
#module "nativecompat"
#deffunc mmloadsafe str f, int n, int o
	exist f
	if strsize < 0 : return
	mmload f, n, o
	return
#global

; 実行環境の拡張getreq ID (本家ランタイム側 sysreq.h と同じ値)
#ifndef SYSREQ_BACKBUTTON
#define global SYSREQ_AD_STATUS 1000
#define global SYSREQ_AD_LASTTIME 1001
#define global SYSREQ_AD_LASTERROR 1002
#define global SYSREQ_AD_CANREQUEST 1003
#define global SYSREQ_BACKBUTTON 1004
#endif

; devcontrol "AdMob",16 の代わり。表示を開始し、結果が出るまで待つ(ミニインタプリタと同じ挙動)
; stat: 1=報酬獲得 / -1=失敗・未準備・報酬なし / -2=クールダウン中
#module "nativead"
#deffunc admobshow16 local r
	devcontrol "AdMob",16
	r=stat
	if r!0 : return r
	repeat 6000
		await 50
		devcontrol "AdMob",19
		r=stat
		if r!2 : break
	loop
	if r=2 : r=-1
	return r
#global

; devcontrol "refresh" の代わり。表示面の作り直しはミニインタプリタ(試し実行)用の命令で、
; 実機Android・Webでは必要ないため、何もしない(コメントを外して残しても安全)
#module "devrefresh"
#deffunc devrefreshnoop
	return
#global

; devcontrol "backup::sog3sd*.dat::",slotmax[,size] の代わり(native_patch.sh が自動で置き換える)。
; バックアップ画面を開き、閉じるまで待つ(その間ゲームは進まない=一時停止)。取り込みが行われたときは、アプリが再起動するので戻らない。
; stat: 0=閉じた / -1=書き方が不正(画面は出ない)
#module "nativebackup"
#deffunc backupshow str pat, int slotmax, int sz, local r
	devcontrol pat, slotmax, sz
	r=stat
	if r<0 : return r
	repeat
		await 50
		devcontrol "backup_poll"
		if stat!2 : break
	loop
	return 0
#global
